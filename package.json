{
  "name": "dynamiclight",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "author": "mskutin",
  "description": "Native USB backlight control for Windows and macOS",
  "repository": { "type": "git", "url": "https://github.com/mskutin/DynamicLight.git" },
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "tauri build --bundles dmg",
    "build:linux": "tauri build --bundles deb,appimage",
    "smoke": "node scripts/smoke.cjs"
  },
  "devDependencies": { "@tauri-apps/cli": "2.12.3" }
}
