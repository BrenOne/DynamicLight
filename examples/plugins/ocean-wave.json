{
  "apiVersion": 1,
  "id": "ocean-wave",
  "name": "Ocean wave",
  "version": "1.0.0",
  "capabilities": [
    "lighting"
  ],
  "program": {
    "kind": "effect",
    "composition": {
      "version": 1,
      "durationMs": 6000,
      "repeats": 0,
      "layers": [
        {
          "kind": "wave",
          "opacity": 100,
          "stops": [
            {
              "position": 0,
              "color": "#103080"
            },
            {
              "position": 1000,
              "color": "#20ddbb"
            }
          ]
        }
      ]
    }
  }
}
