{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DynamicLight",
  "version": "0.2.1",
  "identifier": "com.dynamiclight.desktop",
  "build": { "frontendDist": "../src/ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "DynamicLight", "width": 1180, "height": 830, "minWidth": 900, "minHeight": 720, "backgroundColor": "#101115" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "copyright": "Copyright 2026 mskutin",
    "licenseFile": "../LICENSE",
    "resources": { "../LICENSE": "LICENSE" },
    "category": "Utility",
    "shortDescription": "USB monitor backlight controller",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": {
      "deb": {
        "depends": ["libasound2", "libudev1", "libpipewire-0.3-0", "libxcb1", "libxcb-randr0", "pulseaudio-utils"],
        "recommends": ["libasound2-plugins"],
        "files": {"/usr/lib/udev/rules.d/69-dynamiclight.rules": "linux/69-dynamiclight.rules"},
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm"
      }
    },
    "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist" }
  }
}
